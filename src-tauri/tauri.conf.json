{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceSmith",
  "version": "0.1.4",
  "identifier": "com.voicesmith.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceSmith 璺?GPT-SoVITS 濡楀矂娼板銉ユ綉",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: http://127.0.0.1:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNzdGNDEwOEI1REUzREQKUldUZDQxMkxFUFIzdzBMeHMvTk9HdG9hVXdQZ0ZtYit4RDhucWZpNUlMTkZEb21HZXcvM1hPTGYK",
      "endpoints": [
        "https://github.com/wisdomWindy/voice-smith/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "../sidecar/7zr.exe": "7zr.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
